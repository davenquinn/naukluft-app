.section-page.summary-sections
  .location-group#Tsams
    margin-right 0

  .section-header.subtle h2
    font-weight: 400
    font-size 1em

.section-outer
  position relative

:local(.section-children)
  position absolute
  top 0
  left 0

:global

  div.section-page#generalized-sections svg
    margin-bottom 1em

  div.grouped-sections
    display flex
    flex-direction row

  div.edit-overlay
    div.cursor
      position absolute
      border 2px solid black
      z-index 20

//.location-group
//  position relative
//  &.chemostratigraphy
//    margin 35px 0 0 0

.section-header
  position: relative
  height: var(--section-header-height)
  h2
    position: absolute
    top: 0
    margin-top: 0

.lithostrat-key
  padding: 0 4px
  margin-top: calc(var(--section-header-height) + var(--section-padding-top) + var(--section-key-aligner, 0px))
  background: var(--background-color)
  z-index: 20
  :global
    .timescale .interval-label
      font-size: 16px

.summary-sections
  --section-header-height: 45px
  --section-padding-top: 10px
  // TODO: No idea why we need this to align keys properly
  --section-key-aligner: 12px
  --covered-interval-color: #ffffffcc
  --column-underlay-color:  #ffffffcc
  --triangle-bars-fill-color: #eee
  --triangle-bars-stroke-color: #bbb

  :global(.chemostratigraphy)
    --section-header-height: 57px
