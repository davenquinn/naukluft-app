.isotope-scale-axis
  :global(.vx-line)
    stroke: #aaa
  text
    fill: #888

.chemostratigraphy
  margin-right: 0
  h1
    font-size: 1em
    font-family: var(--main-font-family, sans-serif)
    font-weight: 500
    color: var(--text-color)
  background-color: var(--column-underlay-color, var(--background-color, white))


  .isotopes-column
    padding-right 1em
    position relative
    g.scale
      g.tick
        line
          stroke-width 1px
          stroke #ddd
        &.zero
          line
            stroke #ccc
            stroke-width 2px
        text
          text-anchor middle
          fill #888
          font-size 10px
          font-style italic



.isotopes-column
  rect.underlay
    fill transparent

  // TODO: this is needed to align the sections properly, unfortunately
  .section-header
    height: var(--section-header-height, 30px)
